/// Shows: the classic exercise with `switch` on a pair of remainders.
/// Run:   pelago run programs/fizzbuzz.pel
/// Output:
/// | 1
/// | 2
/// | Fizz
/// | 4
/// | Buzz
/// | Fizz
/// | 7
/// | 8
/// | Fizz
/// | Buzz
/// | 11
/// | Fizz
/// | 13
/// | 14
/// | FizzBuzz
fn main() {
    for i of 1..16 {
        const word = switch (i % 3, i % 5) {
            case (0, 0): "FizzBuzz"
            case (0, _): "Fizz"
            case (_, 0): "Buzz"
            default: "#i"
        }
        print(word)
    }
}
