/// Shows: operator overloading with `impl add for ...`, and equality derived for structs.
/// Run:   pelago run types/operators.pel
/// Output:
/// | 11 22 true
struct vec2 { x: int, y: int }

impl add for vec2 {
    fn add(self, other: vec2) -> vec2 = vec2 { x: self.x + other.x, y: self.y + other.y }
}

fn main() {
    const a = vec2 { x: 1, y: 2 }
    const b = vec2 { x: 10, y: 20 }
    const c = a + b
    print(c.x, c.y, c == vec2 { x: 11, y: 22 })
}
