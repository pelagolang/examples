/// Shows: `enum` with and without data, `switch` over variants with destructuring, and methods on an enum.
/// Run:   pelago run types/enums.pel
/// Output:
/// | 0
/// | 6.75
/// | 10
/// | go
enum shape {
    dot
    circle(radius: float)
    rect(w: float, h: float)

    fn area(self) -> float {
        switch self {
            case .dot: 0.0
            case .circle(r): 3.0 * r * r
            case .rect(w, h): w * h
        }
    }
}

enum colour { red, green, blue }

fn main() {
    const shapes = [shape.dot, shape.circle(1.5), shape.rect(2.5, 4.0)]
    for s of shapes { print(s.area()) }
    const c = colour.green
    switch c {
        case .red: print("stop")
        case .green: print("go")
        case .blue: print("cool")
    }
}
