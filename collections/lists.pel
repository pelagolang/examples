/// Shows: lists: literals, indexing, `first`/`last`, slicing, `push!`, `sortBy!`, searching and `retain!`.
/// Run:   pelago run collections/lists.pel
/// Output:
/// | 6 4 some(42) some(4) [8, 15] [23, 42]
/// | [4, 8, 15, 16, 23, 42, 99]
/// | some(2) none some(4)
/// | [4, 8, 16, 42]
/// | ["fig", "pear", "kiwi", "apple"]
/// | [1, 2, 1, 3] [[1, 2], [3, 4], [5]]
fn main() {
    var xs = [4, 8, 15, 16, 23, 42]
    print(xs.len(), xs[0], xs.last(), xs.first(), xs[1..3], xs[4..])
    xs.push!(99)
    print(xs)
    print(xs.indexOf(15), xs.indexOf(5), xs.binarySearch(23))

    xs.retain!((x) ~> x % 2 == 0)
    print(xs)

    var words = ["pear", "fig", "apple", "kiwi"]
    words.sortBy!((a, b) ~> a.len() - b.len())
    print(words)

    var d = [1, 1, 2, 2, 2, 1, 3, 3]
    d.dedup!()
    print(d, [1, 2, 3, 4, 5].chunks(2).toList())
}
