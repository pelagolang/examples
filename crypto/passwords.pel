/// Shows: `std.password` and `std.bcrypt`: store a password as an encoded hash string and `verify` it later. The cost
/// settings here are small so the example is quick; use larger ones for real passwords.
/// Run:   pelago run crypto/passwords.pel
/// Output:
/// | $argon2id$v=19$m=16,t=1,p=1$c2FsdHNhbHQ$cKY2M6XQJMzOT94nB16ZRF9r1TpmZbG7
/// | true false
/// | true true
import std.bcrypt
import std.password

fn text(s: str) -> [byte] = s.bytes().toList()

fn main() {
    const stored = password.argon2Encoded(2, text("hunter2"), text("saltsalt"), 1, 16, 1, 24)
    print(stored)
    print(password.verify("hunter2", stored), password.verify("hunter3", stored))

    /// An existing bcrypt hash (from the published test vectors) is checked the same way.
    const old = "$2b$04$WUHhXETkX0fnYkrqZU3ta.zcmUrocmI6GiV1XHHkfwFuAlE9bajm6"
    print(password.verify("password", old), bcrypt.check("password", old))
}
