/// Shows: `std.mac` (HMAC: sign and verify a message) and `std.kdf` (HKDF and PBKDF2: derive keys).
/// Run:   pelago run crypto/mac_and_kdf.pel
/// Output:
/// | 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
/// | true
/// | false
/// | 3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865
import std.hash
import std.kdf
import std.mac
import std.sha2
import { sha256 } = std.sha2

fn text(s: str) -> [byte] = s.bytes().toList()

fn main() {
    /// RFC 4231 test case 2.
    const key = text("Jefe")
    const message = text("what do ya want for nothing?")
    const tag = mac.sign(sha256.new(), key, message)
    print(hash.hex(tag))
    print(mac.verify(sha256.new(), key, message, tag))
    print(mac.verify(sha256.new(), key, text("what do ya want for nothing!"), tag))

    /// RFC 5869 test case 1: HKDF turns input key material into as many bytes of key as you ask for.
    const ikm = hash.fromHex("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b") ?? []
    const salt = hash.fromHex("000102030405060708090a0b0c") ?? []
    const info = hash.fromHex("f0f1f2f3f4f5f6f7f8f9") ?? []
    print(hash.hex(kdf.hkdf(sha256.new(), salt, ikm, info, 42)))
}
